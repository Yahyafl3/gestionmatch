<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.gestionmatch.controller.AccueilController">

    <!-- IMAGE DE FOND -->
    <ImageView fitWidth="1920" fitHeight="1080" preserveRatio="false">
        <image>
            <Image url="@../images/Image-18-10-2025-a-09.51-1.jpeg"/>
        </image>
    </ImageView>

    <!-- OVERLAY -->
    <Pane style="-fx-background-color: rgba(0,0,0,0.55);"/>

    <!-- CONTENU -->
    <VBox alignment="CENTER" spacing="40" style="-fx-padding: 40;">

        <VBox alignment="CENTER" spacing="10">
            <Label text="⚽" style="-fx-font-size: 60px;"/>
            <Label text="COUPE DU MONDE FIFA"
                   style="-fx-text-fill: white; -fx-font-size: 42px; -fx-font-weight: bold;"/>
            <HBox alignment="CENTER" spacing="10">
                <Label text="2030" style="-fx-text-fill: white; -fx-font-size: 64px; -fx-font-weight: bold;"/>
                <Label text="•" style="-fx-text-fill: #C1272D; -fx-font-size: 36px;"/>
                <Label text="MAROC"
                       style="-fx-text-fill: #C1272D; -fx-font-size: 46px; -fx-font-weight: bold;"/>
            </HBox>
            <Label text="Système de gestion des équipes et des matchs"
                   style="-fx-text-fill: #dddddd; -fx-font-size: 18px; -fx-font-style: italic;"/>
        </VBox>

        <HBox alignment="CENTER" spacing="25">
            <Button text="🔐 CONNEXION" onAction="#allerConnexion"
                    style="-fx-background-color: #0066CC; -fx-text-fill: white;
                           -fx-font-size: 16px; -fx-font-weight: bold;
                           -fx-padding: 14 40; -fx-background-radius: 30;"/>

            <Button text="📝 INSCRIPTION" onAction="#allerInscription"
                    style="-fx-background-color: #C1272D; -fx-text-fill: white;
                           -fx-font-size: 16px; -fx-font-weight: bold;
                           -fx-padding: 14 40; -fx-background-radius: 30;"/>
        </HBox>

    </VBox>

</StackPane>
