<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.gestionmatch.controller.LoginController"
           stylesheets="@../styles/style.css"
           styleClass="root-stack">

    <!-- Overlay -->
    <Region styleClass="overlay-region" />

    <!-- Carte de connexion -->
    <VBox fx:id="loginCard"
          styleClass="login-card"
          alignment="CENTER"
          spacing="10"
          prefWidth="320"
          prefHeight="350">

        <Label text="Connexion" styleClass="form-title" />

        <VBox spacing="6" prefWidth="280">

            <VBox spacing="2">
                <Label text="Email" styleClass="label-bold" />
                <TextField fx:id="usernameField"
                           promptText="votre@email.com"
                           styleClass="form-field" />
            </VBox>

            <VBox spacing="2">
                <Label text="Mot de passe" styleClass="label-bold" />
                <PasswordField fx:id="passwordField"
                               promptText="Entrez votre mot de passe"
                               styleClass="form-field" />
            </VBox>

            <CheckBox fx:id="rememberMe"
                      text="Se souvenir"
                      styleClass="checkbox-custom" />

            <Button fx:id="loginButton"
                    text="Connexion"
                    onAction="#allerConnexion"
                    styleClass="btn-primary"
                    prefWidth="280"
                    prefHeight="38"
                    minWidth="280"
                    maxWidth="280" />

            <HBox alignment="CENTER" spacing="6">
                <Label text="Pas de compte ?" styleClass="signup-text" />
                <Hyperlink text="S'inscrire"
                           onAction="#sInscrire"
                           styleClass="link-signup" />
            </HBox>

        </VBox>
    </VBox>

</StackPane>
