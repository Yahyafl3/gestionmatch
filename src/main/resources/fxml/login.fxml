<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.gestionmatch.controller.LoginController"
           stylesheets="@../styles/style.css"
           styleClass="root-stack">

    <!-- Overlay semi-transparent -->
    <Region styleClass="overlay-region" />

    <!-- Formulaire centré - PETIT FORMULAIRE -->
    <VBox fx:id="loginCard" styleClass="login-card" alignment="CENTER" spacing="2" prefWidth="320" maxWidth="320" prefHeight="350" maxHeight="350">

        <VBox alignment="CENTER" spacing="0">
            <Label text="Connexion" styleClass="form-title" />
        </VBox>

        <VBox spacing="3" prefWidth="280">
            <VBox spacing="1">
                <Label text="Email" styleClass="label-bold" />
                <TextField fx:id="usernameField" promptText="votre@email.com" styleClass="form-field" />
            </VBox>

            <VBox spacing="1">
                <Label text="Mot de passe" styleClass="label-bold" />
                <PasswordField fx:id="passwordField" promptText="Entrez votre mot de passe" styleClass="form-field" />
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="4">
                <CheckBox fx:id="rememberMe" text="Se souvenir" styleClass="checkbox-custom" />
            </HBox>

            <Button fx:id="loginButton" text="Se connecter" onAction="#allerConnexion" styleClass="btn-primary" prefWidth="280" maxWidth="280" />

            <HBox alignment="CENTER" spacing="4">
                <Label text="Pas de compte ?" styleClass="signup-text" />
                <Hyperlink text="S'inscrire" onAction="#sInscrire" styleClass="link-signup" />
            </HBox>

        </VBox>

    </VBox>

</StackPane>
