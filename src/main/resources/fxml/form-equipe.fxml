<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.gestionmatch.controller.FormEquipeController"
            fitToWidth="true" 
            style="-fx-background: white; -fx-background-color: white;">

<VBox spacing="20" style="-fx-padding: 30; -fx-background-color: white; -fx-background-radius: 16;">

    <!-- TITRE -->
    <HBox alignment="CENTER" style="-fx-background-color: #C1272D; -fx-background-radius: 12; -fx-padding: 15;">
        <Label text="🏆 FORMULAIRE ÉQUIPE" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- SECTION INFORMATIONS GÉNÉRALES -->
    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 12;">
        <Label text="📋 INFORMATIONS GÉNÉRALES" style="-fx-text-fill: #C1272D; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        
        <HBox spacing="15">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Nom de l'équipe *" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <TextField fx:id="nomField" promptText="Ex: Maroc" prefHeight="40"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-font-size: 14px; -fx-padding: 10;"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Pays *" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <TextField fx:id="paysField" promptText="Ex: Maroc" prefHeight="40"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-font-size: 14px; -fx-padding: 10;"/>
            </VBox>
        </HBox>

        <HBox spacing="15">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Entraîneur" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <TextField fx:id="entraineurField" promptText="Ex: Walid Regragui" prefHeight="40"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-font-size: 14px; -fx-padding: 10;"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Nombre de joueurs" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <TextField fx:id="nombreJoueursField" promptText="0" prefHeight="40"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-font-size: 14px; -fx-padding: 10;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- SECTION STATISTIQUES -->
    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #C1272D; -fx-border-width: 2; -fx-border-radius: 12;">
        <Label text="📊 STATISTIQUES" style="-fx-text-fill: #C1272D; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        
        <HBox spacing="12">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Matchs joués" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <TextField fx:id="matchsJouesField" promptText="0" prefHeight="38"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-font-size: 13px; -fx-padding: 8;"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Victoires" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <TextField fx:id="victoiresField" promptText="0" prefHeight="38"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-font-size: 13px; -fx-padding: 8;"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Nuls" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <TextField fx:id="nulsField" promptText="0" prefHeight="38"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-font-size: 13px; -fx-padding: 8;"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Défaites" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <TextField fx:id="defaitesField" promptText="0" prefHeight="38"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-font-size: 13px; -fx-padding: 8;"/>
            </VBox>
        </HBox>

        <HBox spacing="12">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Buts marqués" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <TextField fx:id="butsMarquesField" promptText="0" prefHeight="38"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-font-size: 13px; -fx-padding: 8;"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Buts encaissés" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <TextField fx:id="butsEncaissesField" promptText="0" prefHeight="38"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-font-size: 13px; -fx-padding: 8;"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Points" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <TextField fx:id="pointsField" promptText="0" prefHeight="38"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-font-size: 13px; -fx-padding: 8;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- BOUTONS -->
    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
        <Button fx:id="btnSauvegarder" text="✓ SAUVEGARDER" onAction="#sauvegarder" prefWidth="180" prefHeight="45"
                style="-fx-background-color: #C1272D; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(193, 39, 45, 0.4), 12, 0, 0, 4);"/>
        <Button fx:id="btnAnnuler" text="✗ ANNULER" onAction="#annuler" prefWidth="180" prefHeight="45"
                style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(30, 41, 59, 0.4), 12, 0, 0, 4);"/>
    </HBox>

</VBox>
</ScrollPane>
