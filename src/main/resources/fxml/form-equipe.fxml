<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.gestionmatch.controller.FormEquipeController"
            fitToWidth="true"
            vbarPolicy="ALWAYS"
            hbarPolicy="NEVER"
            prefHeight="600"
            prefWidth="700"
            style="-fx-background: #f8fafc; -fx-background-color: #f8fafc;">

<VBox spacing="25" style="-fx-padding: 35; -fx-background-color: #f8fafc;">

    <!-- TITRE -->
    <HBox alignment="CENTER" style="-fx-background-color: linear-gradient(to right, #C1272D, #A01F24); -fx-background-radius: 14; -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(193, 39, 45, 0.25), 15, 0, 0, 5);">
        <Label text="🏆 FORMULAIRE ÉQUIPE" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold; -fx-letter-spacing: 0.5px;"/>
    </HBox>

    <!-- SECTION INFORMATIONS GÉNÉRALES -->
    <VBox spacing="18" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 25; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.06), 12, 0, 0, 3);">
        <Label text="📋 INFORMATIONS GÉNÉRALES" style="-fx-text-fill: #C1272D; -fx-font-size: 17px; -fx-font-weight: bold; -fx-letter-spacing: 0.3px;"/>
        
        <HBox spacing="18">
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Nom de l'équipe *" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                <TextField fx:id="nomField" promptText="Ex: Maroc" prefHeight="44"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 10; -fx-font-size: 14px; -fx-padding: 12;"/>
            </VBox>
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Pays *" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                <TextField fx:id="paysField" promptText="Ex: Maroc" prefHeight="44"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 10; -fx-font-size: 14px; -fx-padding: 12;"/>
            </VBox>
        </HBox>

        <HBox spacing="18">
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Entraîneur" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                <TextField fx:id="entraineurField" promptText="Ex: Walid Regragui" prefHeight="44"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 10; -fx-font-size: 14px; -fx-padding: 12;"/>
            </VBox>
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Nombre de joueurs" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                <TextField fx:id="nombreJoueursField" promptText="0" prefHeight="44"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 10; -fx-font-size: 14px; -fx-padding: 12;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- SECTION IMAGE DE L'ÉQUIPE -->
    <VBox spacing="18" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 25; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.06), 12, 0, 0, 3);">
        <Label text="🖼️ IMAGE DE L'ÉQUIPE" style="-fx-text-fill: #C1272D; -fx-font-size: 17px; -fx-font-weight: bold; -fx-letter-spacing: 0.3px;"/>
        
        <HBox spacing="18" alignment="CENTER_LEFT">
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Sélectionner une image" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="imagePathField" promptText="Aucune image sélectionnée" editable="false" prefHeight="44" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #f8fafc; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 10; -fx-font-size: 14px; -fx-padding: 12;"/>
                    <Button fx:id="btnChoisirImage" text="📁 Parcourir" onAction="#choisirImage" prefWidth="150" prefHeight="44"
                            style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 13px; -fx-font-weight: 600; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(30, 41, 59, 0.2), 8, 0, 0, 2);"/>
                </HBox>
            </VBox>
        </HBox>
        
        <!-- Aperçu de l'image -->
        <VBox spacing="10" alignment="CENTER">
            <Label text="Aperçu" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: 600;"/>
            <javafx.scene.image.ImageView fx:id="imagePreview" fitWidth="220" fitHeight="165" preserveRatio="true"
                                          style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 12, 0, 0, 3);"/>
        </VBox>
    </VBox>

    <!-- SECTION STATISTIQUES -->
    <VBox spacing="18" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 25; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.06), 12, 0, 0, 3);">
        <Label text="📊 STATISTIQUES" style="-fx-text-fill: #C1272D; -fx-font-size: 17px; -fx-font-weight: bold; -fx-letter-spacing: 0.3px;"/>
        
        <HBox spacing="14">
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Matchs joués" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextField fx:id="matchsJouesField" promptText="0" prefHeight="42"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 10; -fx-font-size: 13px; -fx-padding: 10;"/>
            </VBox>
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Victoires" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextField fx:id="victoiresField" promptText="0" prefHeight="42"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 10; -fx-font-size: 13px; -fx-padding: 10;"/>
            </VBox>
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Nuls" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextField fx:id="nulsField" promptText="0" prefHeight="42"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 10; -fx-font-size: 13px; -fx-padding: 10;"/>
            </VBox>
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Défaites" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextField fx:id="defaitesField" promptText="0" prefHeight="42"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 10; -fx-font-size: 13px; -fx-padding: 10;"/>
            </VBox>
        </HBox>

        <HBox spacing="14">
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Buts marqués" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextField fx:id="butsMarquesField" promptText="0" prefHeight="42"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 10; -fx-font-size: 13px; -fx-padding: 10;"/>
            </VBox>
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Buts encaissés" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextField fx:id="butsEncaissesField" promptText="0" prefHeight="42"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 10; -fx-font-size: 13px; -fx-padding: 10;"/>
            </VBox>
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Points" style="-fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextField fx:id="pointsField" promptText="0" prefHeight="42"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 10; -fx-font-size: 13px; -fx-padding: 10;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- BOUTONS -->
    <HBox spacing="18" alignment="CENTER" style="-fx-padding: 15 0 0 0;">
        <Button fx:id="btnSauvegarder" text="✓ SAUVEGARDER" onAction="#sauvegarder" prefWidth="200" prefHeight="48"
                style="-fx-background-color: linear-gradient(to right, #C1272D, #A01F24); -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(193, 39, 45, 0.3), 12, 0, 0, 4);"/>
        <Button fx:id="btnAnnuler" text="✗ ANNULER" onAction="#annuler" prefWidth="200" prefHeight="48"
                style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(100, 116, 139, 0.3), 12, 0, 0, 4);"/>
    </HBox>

</VBox>
</ScrollPane>
