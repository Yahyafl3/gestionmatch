<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<!-- PAGE STATISTIQUES PROFESSIONNELLE - DONNÉES RÉELLES -->
<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.gestionmatch.controller.StatisticsPageController"
            fitToWidth="true" style="-fx-background: #f8f9fa; -fx-background-color: #f8f9fa;">
    <VBox spacing="25" style="-fx-padding: 30; -fx-background-color: #f8f9fa;">
        
        <!-- Header Moderne -->
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="📊 Statistiques Avancées" style="-fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #1a1a1a;"/>
                <Label text="Analyse en temps réel des performances - Coupe du Monde 2030" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
            </VBox>
            <VBox spacing="8" alignment="CENTER_RIGHT">
                <Label fx:id="totalMatchsLabel" text="0 Matchs" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #C1272D;"/>
                <Label fx:id="totalButsLabel" text="0 Buts" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
            </VBox>
        </HBox>
        
        <!-- Cartes Statistiques Rapides -->
        <GridPane hgap="20" vgap="20">
            <!-- Carte 1: Équipes -->
            <VBox spacing="12" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="🏆" style="-fx-font-size: 28px;"/>
                    <VBox spacing="2">
                        <Label text="Équipes" style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-font-weight: 600;"/>
                        <Label fx:id="statEquipesCard" text="0" style="-fx-font-size: 32px; -fx-font-weight: 700; -fx-text-fill: #1a1a1a;"/>
                    </VBox>
                </HBox>
                <ProgressBar fx:id="progressEquipes" progress="0" prefWidth="200" prefHeight="6" style="-fx-accent: #C1272D;"/>
            </VBox>
            
            <!-- Carte 2: Joueurs -->
            <VBox spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="⚽" style="-fx-font-size: 28px;"/>
                    <VBox spacing="2">
                        <Label text="Joueurs" style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-font-weight: 600;"/>
                        <Label fx:id="statJoueursCard" text="0" style="-fx-font-size: 32px; -fx-font-weight: 700; -fx-text-fill: #1a1a1a;"/>
                    </VBox>
                </HBox>
                <ProgressBar fx:id="progressJoueurs" progress="0" prefWidth="200" prefHeight="6" style="-fx-accent: #10b981;"/>
            </VBox>
            
            <!-- Carte 3: Stades -->
            <VBox spacing="12" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="🏟️" style="-fx-font-size: 28px;"/>
                    <VBox spacing="2">
                        <Label text="Stades" style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-font-weight: 600;"/>
                        <Label fx:id="statStadesCard" text="0" style="-fx-font-size: 32px; -fx-font-weight: 700; -fx-text-fill: #1a1a1a;"/>
                    </VBox>
                </HBox>
                <ProgressBar fx:id="progressStades" progress="0" prefWidth="200" prefHeight="6" style="-fx-accent: #3b82f6;"/>
            </VBox>
            
            <!-- Carte 4: Groupes -->
            <VBox spacing="12" GridPane.columnIndex="3" GridPane.rowIndex="0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="📋" style="-fx-font-size: 28px;"/>
                    <VBox spacing="2">
                        <Label text="Groupes" style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-font-weight: 600;"/>
                        <Label fx:id="statGroupesCard" text="0" style="-fx-font-size: 32px; -fx-font-weight: 700; -fx-text-fill: #1a1a1a;"/>
                    </VBox>
                </HBox>
                <ProgressBar fx:id="progressGroupes" progress="0" prefWidth="200" prefHeight="6" style="-fx-accent: #f59e0b;"/>
            </VBox>
        </GridPane>
        
        <!-- Graphiques Principaux -->
        <HBox spacing="20" VBox.vgrow="ALWAYS" style="-fx-pref-height: 380;">
            
            <!-- Graphique Buts par Équipe -->
            <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="⚽" style="-fx-font-size: 20px;"/>
                    <Label text="Top 8 Équipes - Buts Marqués" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #1a1a1a;"/>
                </HBox>
                <Separator style="-fx-background-color: #e5e7eb;"/>
                <BarChart fx:id="butsChart" legendVisible="false" VBox.vgrow="ALWAYS" animated="true" style="-fx-pref-height: 300;">
                    <xAxis>
                        <CategoryAxis label="Équipes" style="-fx-font-size: 11px; -fx-font-weight: 600;"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Buts" side="LEFT" style="-fx-font-size: 11px; -fx-font-weight: 600;"/>
                    </yAxis>
                </BarChart>
            </VBox>
            
            <!-- Graphique Résultats des Matchs -->
            <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📊" style="-fx-font-size: 20px;"/>
                    <Label text="Répartition des Résultats" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #1a1a1a;"/>
                </HBox>
                <Separator style="-fx-background-color: #e5e7eb;"/>
                <PieChart fx:id="resultsChart" legendVisible="true" VBox.vgrow="ALWAYS" animated="true" style="-fx-pref-height: 300;"/>
            </VBox>
            
        </HBox>
        
        <!-- Top 5 Équipes avec Drapeaux -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="🏆" style="-fx-font-size: 20px;"/>
                <Label text="Top 5 Équipes - Classement" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #1a1a1a;"/>
            </HBox>
            <Separator style="-fx-background-color: #e5e7eb;"/>
            
            <GridPane fx:id="top5Grid" hgap="15" vgap="15">
                <!-- Les équipes seront ajoutées dynamiquement -->
            </GridPane>
        </VBox>
        
        <!-- Statistiques Détaillées par Groupe -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📋" style="-fx-font-size: 20px;"/>
                <Label text="Statistiques par Groupe" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #1a1a1a;"/>
            </HBox>
            <Separator style="-fx-background-color: #e5e7eb;"/>
            
            <GridPane fx:id="groupesStatsGrid" hgap="20" vgap="20">
                <!-- Les groupes seront ajoutés dynamiquement -->
            </GridPane>
        </VBox>
        
    </VBox>
</ScrollPane>
