<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fx:id="scrollPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.gestionmatch.controller.CalendarPageController"
            fitToWidth="true" style="-fx-background: #ffffff; -fx-background-color: #ffffff;">
    <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #ffffff;">
        
        <!-- Header -->
        <VBox alignment="CENTER" spacing="8" style="-fx-background-color: linear-gradient(to right, #C1272D, #8B1C1C); -fx-padding: 20; -fx-background-radius: 10;">
            <Label text="COUPE DU MONDE 2030" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: white;"/>
            <Label text="Calendrier Complet - Phase de Poules et Phase Finale" style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: 600;"/>
        </VBox>
        
        <!-- Phase de Poules Title -->
        <HBox alignment="CENTER" style="-fx-background-color: #FFD700; -fx-padding: 12; -fx-background-radius: 8;">
            <Label text="PHASE DE POULES" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #8B1C1C;"/>
        </HBox>
        
        <!-- Groups Container -->
        <HBox fx:id="groupsContainer" spacing="10" alignment="CENTER" style="-fx-padding: 10;">
            <!-- Groups will be populated dynamically -->
        </HBox>
        
        <!-- Match Schedule Title -->
        <HBox alignment="CENTER" style="-fx-background-color: #C1272D; -fx-padding: 12; -fx-background-radius: 8;">
            <Label text="CALENDRIER DES MATCHS" style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: white;"/>
        </HBox>
        
        <!-- Match Schedule by Date -->
        <VBox fx:id="matchScheduleContainer" spacing="15" style="-fx-padding: 10;">
            <!-- Match schedule will be populated dynamically -->
        </VBox>
        
        <!-- Phase Finale Title -->
        <HBox alignment="CENTER" style="-fx-background-color: #FFD700; -fx-padding: 12; -fx-background-radius: 8;">
            <Label text="PHASE FINALE" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #8B1C1C;"/>
        </HBox>
        
        <!-- Knockout Stage Container -->
        <VBox fx:id="knockoutContainer" spacing="20" style="-fx-padding: 20; -fx-background-color: #8B1C1C; -fx-background-radius: 10;">
            <!-- Knockout bracket will be populated dynamically -->
        </VBox>
        
    </VBox>
</ScrollPane>
