<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.chart.*?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.example.gestionmatch.controller.AdminDashboardController"
            stylesheets="@../styles/dashboard.css, @../styles/enhanced-dashboard.css"
            style="-fx-background-color: #f8fafc;">

    <!-- SIDEBAR ROUGE AVEC BOUTONS NOIRS -->
    <left>
        <VBox style="-fx-background-color: #C1272D; -fx-pref-width: 260; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 25, 0, 8, 0);" spacing="0">
            
            <!-- Logo avec fond noir subtil -->
            <VBox alignment="CENTER" style="-fx-padding: 35 25; -fx-background-color: rgba(0,0,0,0.15);" spacing="16">
                <ImageView fitWidth="180" fitHeight="80" preserveRatio="true">
                    <image>
                        <Image url="@../images/4.png" backgroundLoading="true" />
                    </image>
                </ImageView>
                <Label text="Admin Dashboard" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-letter-spacing: 1px;"/>
            </VBox>

            <!-- Menu avec boutons noirs -->
            <VBox spacing="12" style="-fx-padding: 30 20;">
                <Label text="NAVIGATION" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0 12 12 12; -fx-letter-spacing: 2px;"/>
                
                <Button fx:id="btnDashboard" text="📊  Dashboard" onAction="#afficherDashboard" styleClass="sidebar-button-active"
                        style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 220; -fx-pref-height: 48; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 24; -fx-font-weight: 600;"/>
                
                <Button fx:id="btnJoueurs" text="👤  Joueurs" onAction="#afficherJoueurs" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 14px; -fx-pref-width: 220; -fx-pref-height: 48; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 24; -fx-font-weight: 500;"/>
                
                <Button fx:id="btnEquipes" text="🏆  Équipes" onAction="#afficherEquipes" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 14px; -fx-pref-width: 220; -fx-pref-height: 48; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 24; -fx-font-weight: 500;"/>
                
                <Button fx:id="btnStades" text="🏟️  Stades" onAction="#afficherStades" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 14px; -fx-pref-width: 220; -fx-pref-height: 48; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 24; -fx-font-weight: 500;"/>
                
                <Button fx:id="btnGroupes" text="📋  Groupes" onAction="#afficherGroupes" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 14px; -fx-pref-width: 220; -fx-pref-height: 48; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 24; -fx-font-weight: 500;"/>
                
                <Button fx:id="btnMatchs" text="⚽  Matchs" onAction="#afficherMatchs" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 14px; -fx-pref-width: 220; -fx-pref-height: 48; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 24; -fx-font-weight: 500;"/>
                
                <Label text="ANALYSES" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 20 12 12 12; -fx-letter-spacing: 2px;"/>
                
                <Button fx:id="btnCalendrier" text="📅  Calendrier" onAction="#afficherCalendrier" styleClass="sidebar-button"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 14px; -fx-pref-width: 220; -fx-pref-height: 48; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 24; -fx-font-weight: 500;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Logout avec fond noir -->
            <VBox style="-fx-padding: 25 20;" alignment="CENTER">
                <Button text="🚪  Déconnexion" onAction="#deconnecter" 
                        style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 220; -fx-pref-height: 48; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: 600;"/>
            </VBox>
        </VBox>
    </left>


    <!-- CONTENU PRINCIPAL MODERNE -->
    <center>
        <VBox>
            
            <!-- Header Moderne avec espacement généreux -->
            <HBox alignment="CENTER_LEFT" spacing="25" styleClass="modern-header" style="-fx-padding: 30 45;">
                <VBox spacing="6">
                    <Label fx:id="pageTitle" text="Dashboard" styleClass="page-title" style="-fx-font-size: 32px; -fx-font-weight: 700;"/>
                    <Label text="Vue d'ensemble - Coupe du Monde 2030" styleClass="page-subtitle" style="-fx-font-size: 14px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT" spacing="4">
                    <Label fx:id="dateLabel" text="7 Janvier 2026" style="-fx-text-fill: #475569; -fx-font-size: 14px; -fx-font-weight: 600;"/>
                    <Label fx:id="timeLabel" text="23:15" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                </VBox>
            </HBox>

            <!-- Zone de contenu scrollable moderne avec espacement généreux -->
            <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="modern-scroll-pane" VBox.vgrow="ALWAYS" style="-fx-background: #f8fafc; -fx-background-color: #f8fafc;">
                <StackPane fx:id="contentPane" style="-fx-padding: 35; -fx-background-color: #f8fafc;">
                    
                    <!-- DASHBOARD PROFESSIONNEL COMPACT -->
                    <VBox fx:id="dashboardView" spacing="24" alignment="TOP_CENTER" style="-fx-padding: 12;">
                        
                        <!-- Première ligne: 3 grandes cartes colorées modernes (sans la première) -->
                        <HBox spacing="22" alignment="CENTER">
                            
                            <!-- CARTE 1: Équipes (Bleu moderne) -->
                            <VBox spacing="14" alignment="TOP_LEFT" HBox.hgrow="ALWAYS" styleClass="modern-stat-card" style="-fx-padding: 22;">
                                <HBox spacing="14" alignment="CENTER_LEFT">
                                    <StackPane styleClass="icon-circle-blue" alignment="CENTER" style="-fx-pref-width: 56; -fx-pref-height: 56;">
                                        <Label text="🏆" style="-fx-font-size: 28px;"/>
                                    </StackPane>
                                    <VBox spacing="3">
                                        <Label text="Équipes" styleClass="stat-label" style="-fx-font-size: 12px;"/>
                                        <Label fx:id="statEquipes" text="0" styleClass="stat-number" style="-fx-font-size: 34px;"/>
                                    </VBox>
                                </HBox>
                                <Label text="32 équipes max" styleClass="stat-subtitle" style="-fx-font-size: 11px;"/>
                            </VBox>
                            
                            <!-- CARTE 2: Matchs (Vert moderne) -->
                            <VBox spacing="14" alignment="TOP_LEFT" HBox.hgrow="ALWAYS" styleClass="modern-stat-card" style="-fx-padding: 22;">
                                <HBox spacing="14" alignment="CENTER_LEFT">
                                    <StackPane styleClass="icon-circle-green" alignment="CENTER" style="-fx-pref-width: 56; -fx-pref-height: 56;">
                                        <Label text="⚽" style="-fx-font-size: 28px;"/>
                                    </StackPane>
                                    <VBox spacing="3">
                                        <Label text="Matchs" styleClass="stat-label" style="-fx-font-size: 12px;"/>
                                        <Label fx:id="statMatchs" text="0" styleClass="stat-number" style="-fx-font-size: 34px;"/>
                                    </VBox>
                                </HBox>
                                <Label text="64 matchs total" styleClass="stat-subtitle" style="-fx-font-size: 11px;"/>
                            </VBox>
                            
                            <!-- CARTE 3: Stades (Violet moderne) -->
                            <VBox spacing="14" alignment="TOP_LEFT" HBox.hgrow="ALWAYS" styleClass="modern-stat-card" style="-fx-padding: 22;">
                                <HBox spacing="14" alignment="CENTER_LEFT">
                                    <StackPane styleClass="icon-circle-purple" alignment="CENTER" style="-fx-pref-width: 56; -fx-pref-height: 56;">
                                        <Label text="🏟️" style="-fx-font-size: 28px;"/>
                                    </StackPane>
                                    <VBox spacing="3">
                                        <Label text="Stades" styleClass="stat-label" style="-fx-font-size: 12px;"/>
                                        <Label fx:id="statStades" text="0" styleClass="stat-number" style="-fx-font-size: 34px;"/>
                                    </VBox>
                                </HBox>
                                <Label text="Capacité totale" styleClass="stat-subtitle" style="-fx-font-size: 11px;"/>
                            </VBox>
                            
                            <!-- CARTE 4: Joueurs (Rouge moderne) -->
                            <VBox spacing="14" alignment="TOP_LEFT" HBox.hgrow="ALWAYS" styleClass="modern-stat-card" style="-fx-padding: 22;">
                                <HBox spacing="14" alignment="CENTER_LEFT">
                                    <StackPane styleClass="icon-circle-red" alignment="CENTER" style="-fx-pref-width: 56; -fx-pref-height: 56;">
                                        <Label text="👤" style="-fx-font-size: 28px;"/>
                                    </StackPane>
                                    <VBox spacing="3">
                                        <Label text="Joueurs" styleClass="stat-label" style="-fx-font-size: 12px;"/>
                                        <Label fx:id="statJoueurs" text="0" styleClass="stat-number" style="-fx-font-size: 34px;"/>
                                    </VBox>
                                </HBox>
                                <Label text="Total inscrits" styleClass="stat-subtitle" style="-fx-font-size: 11px;"/>
                            </VBox>
                            
                        </HBox>
                        
                        <!-- Deuxième ligne: 3 mini-cartes modernes (sans Top Joueurs) -->
                        <HBox spacing="22" alignment="CENTER">
                            
                            <!-- Mini-carte 1: Taux avec ProgressBar moderne -->
                            <VBox spacing="12" alignment="TOP_LEFT" HBox.hgrow="ALWAYS" styleClass="modern-stat-card" maxWidth="280" style="-fx-padding: 20;">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <StackPane styleClass="icon-circle-red" alignment="CENTER" style="-fx-pref-width: 48; -fx-pref-height: 48;">
                                        <Label text="📈" style="-fx-font-size: 22px;"/>
                                    </StackPane>
                                    <VBox spacing="3">
                                        <Label text="Taux Remplissage" styleClass="stat-label" style="-fx-font-size: 10px;"/>
                                        <Label text="Équipes / 32" styleClass="stat-subtitle" style="-fx-font-size: 9px;"/>
                                    </VBox>
                                </HBox>
                                <Label fx:id="statTaux" text="0%" style="-fx-text-fill: #C1272D; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                                <ProgressBar fx:id="progressTaux" progress="0" prefWidth="240" prefHeight="12" styleClass="modern-progress-bar"/>
                            </VBox>
                            
                            <!-- Mini-carte 2: Groupes moderne -->
                            <VBox spacing="12" alignment="TOP_LEFT" HBox.hgrow="ALWAYS" styleClass="modern-stat-card" maxWidth="280" style="-fx-padding: 20;">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <StackPane styleClass="icon-circle-orange" alignment="CENTER" style="-fx-pref-width: 48; -fx-pref-height: 48;">
                                        <Label text="📋" style="-fx-font-size: 22px;"/>
                                    </StackPane>
                                    <VBox spacing="3">
                                        <Label text="Groupes" styleClass="stat-label" style="-fx-font-size: 10px;"/>
                                        <Label text="Total créés" styleClass="stat-subtitle" style="-fx-font-size: 9px;"/>
                                    </VBox>
                                </HBox>
                                <HBox spacing="10" alignment="BASELINE_LEFT">
                                    <Label fx:id="statGroupes" text="0" style="-fx-text-fill: #ea580c; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                                    <Label text="/ 8" styleClass="stat-subtitle" style="-fx-font-size: 16px;"/>
                                </HBox>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <VBox fx:id="barGroupes" spacing="0" style="-fx-background-color: #ea580c; -fx-pref-width: 120; -fx-pref-height: 12; -fx-background-radius: 6;"/>
                                    <VBox spacing="0" style="-fx-background-color: #fed7aa; -fx-pref-width: 120; -fx-pref-height: 12; -fx-background-radius: 6;"/>
                                </HBox>
                            </VBox>
                            
                            <!-- Mini-carte 3: Buts moderne -->
                            <VBox spacing="12" alignment="TOP_LEFT" HBox.hgrow="ALWAYS" styleClass="modern-stat-card" maxWidth="280" style="-fx-padding: 20;">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <StackPane styleClass="icon-circle-green" alignment="CENTER" style="-fx-pref-width: 48; -fx-pref-height: 48;">
                                        <Label text="🎯" style="-fx-font-size: 22px;"/>
                                    </StackPane>
                                    <VBox spacing="3">
                                        <Label text="Buts Marqués" styleClass="stat-label" style="-fx-font-size: 10px;"/>
                                        <Label text="Total compétition" styleClass="stat-subtitle" style="-fx-font-size: 9px;"/>
                                    </VBox>
                                </HBox>
                                <Label fx:id="statButs" text="0" style="-fx-text-fill: #059669; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                                <HBox spacing="7" alignment="CENTER_LEFT">
                                    <VBox spacing="0" style="-fx-background-color: #059669; -fx-pref-width: 75; -fx-pref-height: 12; -fx-background-radius: 6;"/>
                                    <VBox spacing="0" style="-fx-background-color: #a7f3d0; -fx-pref-width: 75; -fx-pref-height: 12; -fx-background-radius: 6;"/>
                                    <VBox spacing="0" style="-fx-background-color: #d1fae5; -fx-pref-width: 75; -fx-pref-height: 12; -fx-background-radius: 6;"/>
                                </HBox>
                            </VBox>
                            
                        </HBox>
                        
                        <!-- Troisième ligne: 2 sections modernes plus compactes -->
                        <HBox spacing="22" alignment="TOP_CENTER">
                            
                            <!-- Top 5 Équipes moderne sans numéros -->
                            <VBox spacing="16" HBox.hgrow="ALWAYS" maxWidth="550" styleClass="modern-stat-card" style="-fx-padding: 24;">
                                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 0 10 0; -fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 2 0;">
                                    <StackPane styleClass="icon-circle-blue" alignment="CENTER" style="-fx-pref-width: 48; -fx-pref-height: 48;">
                                        <Label text="🏆" style="-fx-font-size: 22px;"/>
                                    </StackPane>
                                    <VBox spacing="2">
                                        <Label text="Top 5 Équipes" styleClass="section-header" style="-fx-font-size: 16px;"/>
                                        <Label text="Classement par points" styleClass="section-subtitle" style="-fx-font-size: 11px;"/>
                                    </VBox>
                                </HBox>
                                <VBox fx:id="top5Equipes" spacing="10">
                                    <!-- Les équipes seront ajoutées dynamiquement -->
                                </VBox>
                            </VBox>
                            
                            <!-- Prochains Matchs moderne -->
                            <VBox fx:id="prochainsMatchsContainer" spacing="16" HBox.hgrow="ALWAYS" maxWidth="550" styleClass="modern-stat-card" style="-fx-padding: 24;">
                                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 0 10 0; -fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 2 0;">
                                    <StackPane styleClass="icon-circle-green" alignment="CENTER" style="-fx-pref-width: 48; -fx-pref-height: 48;">
                                        <Label text="⚽" style="-fx-font-size: 22px;"/>
                                    </StackPane>
                                    <VBox spacing="2">
                                        <Label text="Prochains Matchs" styleClass="section-header" style="-fx-font-size: 16px;"/>
                                        <Label text="Calendrier à venir" styleClass="section-subtitle" style="-fx-font-size: 11px;"/>
                                    </VBox>
                                </HBox>
                                <VBox fx:id="prochainsMatchsList" spacing="12">
                                    <!-- Les matchs seront chargés dynamiquement -->
                                </VBox>
                            </VBox>
                            
                        </HBox>
                        
                    </VBox>


                    <!-- VUE JOUEURS -->
                    <VBox fx:id="joueursView" visible="false" spacing="28">
                        <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 4);">
                            <Label text="👤 Gestion des Joueurs" style="-fx-text-fill: #0f172a; -fx-font-size: 26px; -fx-font-weight: 700; -fx-letter-spacing: -0.5px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="➕ Ajouter" onAction="#ajouterJoueur" 
                                    style="-fx-background-color: #C1272D; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(193, 39, 45, 0.25), 10, 0, 0, 3);"/>
                            <Button text="✏️ Modifier" onAction="#modifierJoueur" 
                                    style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(100, 116, 139, 0.25), 10, 0, 0, 3);"/>
                            <Button text="🗑️ Supprimer" onAction="#supprimerJoueur" 
                                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(239, 68, 68, 0.25), 10, 0, 0, 3);"/>
                        </HBox>
                        
                        <!-- Barre de recherche -->
                        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 4);">
                            <Label text="🔍" style="-fx-font-size: 20px;"/>
                            <TextField fx:id="searchFieldJoueurs" promptText="Rechercher un joueur par nom..." 
                                       style="-fx-pref-width: 450; -fx-pref-height: 44; -fx-font-size: 14px; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12;"/>
                            <Button text="Rechercher" onAction="#rechercherJoueur" 
                                    style="-fx-background-color: #C1272D; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 24; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600;"/>
                            <Button text="Réinitialiser" onAction="#reinitialiserRechercheJoueurs" 
                                    style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 24; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600;"/>
                        </HBox>
                        
                        <VBox style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 4);">
                            <TableView fx:id="tableJoueurs" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </VBox>

                    <!-- VUE ÉQUIPES -->
                    <VBox fx:id="equipesView" visible="false" spacing="28">
                        <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 4);">
                            <Label text="🏆 Gestion des Équipes" style="-fx-text-fill: #0f172a; -fx-font-size: 26px; -fx-font-weight: 700; -fx-letter-spacing: -0.5px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="➕ Ajouter" onAction="#ajouterEquipe" 
                                    style="-fx-background-color: #C1272D; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(193, 39, 45, 0.25), 10, 0, 0, 3);"/>
                            <Button text="✏️ Modifier" onAction="#modifierEquipe" 
                                    style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(100, 116, 139, 0.25), 10, 0, 0, 3);"/>
                            <Button text="🗑️ Supprimer" onAction="#supprimerEquipe" 
                                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(239, 68, 68, 0.25), 10, 0, 0, 3);"/>
                        </HBox>
                        <VBox style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 4);">
                            <TableView fx:id="tableEquipes" VBox.vgrow="ALWAYS" prefHeight="500" styleClass="table-equipes"/>
                        </VBox>
                    </VBox>

                    <!-- VUE STADES -->
                    <VBox fx:id="stadesView" visible="false" spacing="28">
                        <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 4);">
                            <Label text="🏟️ Gestion des Stades" style="-fx-text-fill: #0f172a; -fx-font-size: 26px; -fx-font-weight: 700; -fx-letter-spacing: -0.5px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="➕ Ajouter" onAction="#ajouterStade" 
                                    style="-fx-background-color: #C1272D; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(193, 39, 45, 0.25), 10, 0, 0, 3);"/>
                            <Button text="✏️ Modifier" onAction="#modifierStade" 
                                    style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(100, 116, 139, 0.25), 10, 0, 0, 3);"/>
                            <Button text="🗑️ Supprimer" onAction="#supprimerStade" 
                                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(239, 68, 68, 0.25), 10, 0, 0, 3);"/>
                        </HBox>
                        <VBox style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 4);">
                            <TableView fx:id="tableStades" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </VBox>

                    <!-- VUE GROUPES MODERNE -->
                    <VBox fx:id="groupesView" visible="false" spacing="28">
                        <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 4);">
                            <Label text="📋 Gestion des Groupes" style="-fx-text-fill: #0f172a; -fx-font-size: 26px; -fx-font-weight: 700; -fx-letter-spacing: -0.5px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="➕ Créer Groupe" onAction="#creerGroupe" 
                                    style="-fx-background-color: #C1272D; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(193, 39, 45, 0.25), 10, 0, 0, 3);"/>
                            <Button fx:id="btnAjouterEquipe" text="➕ Ajouter Équipe" onAction="#ajouterEquipeSelectionne" 
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.25), 10, 0, 0, 3);"/>
                            <Button fx:id="btnModifierGroupe" text="✏️ Modifier" onAction="#modifierGroupeSelectionne" 
                                    style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(30, 41, 59, 0.25), 10, 0, 0, 3);"/>
                            <Button fx:id="btnSupprimerGroupe" text="🗑️ Supprimer" onAction="#supprimerGroupeSelectionne" 
                                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(239, 68, 68, 0.25), 10, 0, 0, 3);"/>
                            <Button fx:id="btnRetirerEquipe" text="✖ Retirer Équipe" onAction="#retirerEquipeSelectionne" 
                                    style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(245, 158, 11, 0.25), 10, 0, 0, 3);"/>
                        </HBox>
                        
                        <!-- Grille des groupes -->
                        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                            <GridPane fx:id="groupesGrid" hgap="22" vgap="22" style="-fx-padding: 12; -fx-background-color: transparent;"/>
                        </ScrollPane>
                    </VBox>

                    <!-- VUE MATCHS -->
                    <VBox fx:id="matchsView" visible="false" spacing="28">
                        <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 4);">
                            <Label text="⚽ Gestion des Matchs" style="-fx-text-fill: #0f172a; -fx-font-size: 26px; -fx-font-weight: 700; -fx-letter-spacing: -0.5px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="➕ Ajouter" onAction="#ajouterMatch" 
                                    style="-fx-background-color: #C1272D; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(193, 39, 45, 0.25), 10, 0, 0, 3);"/>
                            <Button text="✏️ Modifier" onAction="#modifierMatch" 
                                    style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(100, 116, 139, 0.25), 10, 0, 0, 3);"/>
                            <Button text="🗑️ Supprimer" onAction="#supprimerMatch" 
                                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(239, 68, 68, 0.25), 10, 0, 0, 3);"/>
                        </HBox>
                        <VBox style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 4);">
                            <TableView fx:id="tableMatchs" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </VBox>

                </StackPane>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
