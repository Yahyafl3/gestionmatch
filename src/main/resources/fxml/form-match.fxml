<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.gestionmatch.controller.FormMatchController"
      spacing="20" style="-fx-padding: 30; -fx-background-color: white; -fx-background-radius: 16;">

    <!-- Titre -->
    <HBox alignment="CENTER" style="-fx-background-color: #C1272D; -fx-background-radius: 12; -fx-padding: 15;">
        <Label text="⚽ FORMULAIRE MATCH" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Champs du formulaire -->
    <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 12;">
        
        <HBox spacing="15">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Équipe 1 *" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <ComboBox fx:id="equipe1Combo" prefHeight="40" prefWidth="200"
                          style="-fx-background-color: white; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px;"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Équipe 2 *" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <ComboBox fx:id="equipe2Combo" prefHeight="40" prefWidth="200"
                          style="-fx-background-color: white; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px;"/>
            </VBox>
        </HBox>

        <VBox spacing="8">
            <Label text="Stade *" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <ComboBox fx:id="stadeCombo" prefHeight="40" prefWidth="400"
                      style="-fx-background-color: white; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px;"/>
        </VBox>

        <VBox spacing="8">
            <Label text="Date du match *" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <DatePicker fx:id="datePicker" prefHeight="40"
                        style="-fx-background-color: white; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px;"/>
        </VBox>

        <HBox spacing="15">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Score Équipe 1" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <TextField fx:id="score1Field" promptText="0" prefHeight="40"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-font-size: 14px; -fx-padding: 10;"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Score Équipe 2" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <TextField fx:id="score2Field" promptText="0" prefHeight="40"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-width: 2; -fx-border-radius: 8; -fx-font-size: 14px; -fx-padding: 10;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Boutons -->
    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
        <Button fx:id="btnSauvegarder" text="✓ SAUVEGARDER" onAction="#sauvegarder" prefWidth="180" prefHeight="45"
                style="-fx-background-color: #C1272D; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(193, 39, 45, 0.4), 12, 0, 0, 4);"/>
        <Button fx:id="btnAnnuler" text="✗ ANNULER" onAction="#annuler" prefWidth="180" prefHeight="45"
                style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(30, 41, 59, 0.4), 12, 0, 0, 4);"/>
    </HBox>

</VBox>
