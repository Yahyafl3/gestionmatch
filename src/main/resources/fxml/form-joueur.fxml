<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.gestionmatch.controller.FormJoueurController"
      spacing="12" style="-fx-padding: 20; -fx-background-color: #1a1f3a;">

    <Label text="Formulaire Joueur" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Nom" style="-fx-text-fill: #ccc; -fx-font-size: 11px;"/>
            <TextField fx:id="nomField" promptText="Nom" prefHeight="32"
                       style="-fx-background-color: #0f1429; -fx-text-fill: white; -fx-prompt-text-fill: #666; -fx-background-radius: 6; -fx-border-color: #2a2f4a; -fx-border-width: 1; -fx-border-radius: 6;"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Prénom" style="-fx-text-fill: #ccc; -fx-font-size: 11px;"/>
            <TextField fx:id="prenomField" promptText="Prénom" prefHeight="32"
                       style="-fx-background-color: #0f1429; -fx-text-fill: white; -fx-prompt-text-fill: #666; -fx-background-radius: 6; -fx-border-color: #2a2f4a; -fx-border-width: 1; -fx-border-radius: 6;"/>
        </VBox>
    </HBox>

    <HBox spacing="10">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Numéro" style="-fx-text-fill: #ccc; -fx-font-size: 11px;"/>
            <TextField fx:id="numeroField" promptText="Ex: 7" prefHeight="32"
                       style="-fx-background-color: #0f1429; -fx-text-fill: white; -fx-prompt-text-fill: #666; -fx-background-radius: 6; -fx-border-color: #2a2f4a; -fx-border-width: 1; -fx-border-radius: 6;"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Poste" style="-fx-text-fill: #ccc; -fx-font-size: 11px;"/>
            <ComboBox fx:id="posteCombo" prefHeight="32" prefWidth="200"
                      style="-fx-background-color: #0f1429; -fx-text-fill: white; -fx-background-radius: 6;"/>
        </VBox>
    </HBox>

    <VBox spacing="6">
        <Label text="Équipe" style="-fx-text-fill: #ccc; -fx-font-size: 11px;"/>
        <ComboBox fx:id="equipeCombo" prefHeight="32" prefWidth="400"
                  style="-fx-background-color: #0f1429; -fx-text-fill: white; -fx-background-radius: 6;"/>
    </VBox>

    <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
        <Button fx:id="btnSauvegarder" text="SAUVEGARDER" onAction="#sauvegarder" prefWidth="150" prefHeight="35"
                style="-fx-background-color: #006233; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button fx:id="btnAnnuler" text="ANNULER" onAction="#annuler" prefWidth="150" prefHeight="35"
                style="-fx-background-color: #8B1F23; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

</VBox>
