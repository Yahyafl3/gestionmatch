<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.gestionmatch.controller.FormStadeController"
      spacing="15" style="-fx-padding: 20; -fx-background-color: #1a1f3a;">

    <Label text="Formulaire Stade" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

    <VBox spacing="8">
        <Label text="Nom du stade" style="-fx-text-fill: #ccc; -fx-font-size: 12px;"/>
        <TextField fx:id="nomField" promptText="Ex: Stade Mohammed V" prefHeight="35"
                   style="-fx-background-color: #0f1429; -fx-text-fill: white; -fx-prompt-text-fill: #666; -fx-background-radius: 6; -fx-border-color: #2a2f4a; -fx-border-width: 1; -fx-border-radius: 6;"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Ville" style="-fx-text-fill: #ccc; -fx-font-size: 12px;"/>
        <TextField fx:id="villeField" promptText="Ex: Casablanca" prefHeight="35"
                   style="-fx-background-color: #0f1429; -fx-text-fill: white; -fx-prompt-text-fill: #666; -fx-background-radius: 6; -fx-border-color: #2a2f4a; -fx-border-width: 1; -fx-border-radius: 6;"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Pays" style="-fx-text-fill: #ccc; -fx-font-size: 12px;"/>
        <TextField fx:id="paysField" promptText="Ex: Maroc" prefHeight="35"
                   style="-fx-background-color: #0f1429; -fx-text-fill: white; -fx-prompt-text-fill: #666; -fx-background-radius: 6; -fx-border-color: #2a2f4a; -fx-border-width: 1; -fx-border-radius: 6;"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Capacité" style="-fx-text-fill: #ccc; -fx-font-size: 12px;"/>
        <TextField fx:id="capaciteField" promptText="Ex: 45000" prefHeight="35"
                   style="-fx-background-color: #0f1429; -fx-text-fill: white; -fx-prompt-text-fill: #666; -fx-background-radius: 6; -fx-border-color: #2a2f4a; -fx-border-width: 1; -fx-border-radius: 6;"/>
    </VBox>

    <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
        <Button fx:id="btnSauvegarder" text="SAUVEGARDER" onAction="#sauvegarder" prefWidth="150" prefHeight="35"
                style="-fx-background-color: #006233; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button fx:id="btnAnnuler" text="ANNULER" onAction="#annuler" prefWidth="150" prefHeight="35"
                style="-fx-background-color: #8B1F23; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

</VBox>
