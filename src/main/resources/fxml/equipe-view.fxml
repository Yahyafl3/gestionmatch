<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.gestionmatch.controller.EquipeController"
      spacing="20" style="-fx-padding: 30; -fx-background-color: white;">

    <!-- TITRE -->
    <HBox alignment="CENTER" style="-fx-background-color: #C1272D; -fx-background-radius: 12; -fx-padding: 15;">
        <Label text="🏆 GESTION DES ÉQUIPES" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- BOUTONS -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button text="➕ Ajouter" onAction="#ajouterEquipe" prefWidth="150" prefHeight="40"
                style="-fx-background-color: #C1272D; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button fx:id="btnModifier" text="✏️ Modifier" onAction="#modifierEquipe" prefWidth="150" prefHeight="40"
                style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button fx:id="btnSupprimer" text="🗑️ Supprimer" onAction="#supprimerEquipe" prefWidth="150" prefHeight="40"
                style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button text="🔄 Actualiser" onAction="#actualiser" prefWidth="150" prefHeight="40"
                style="-fx-background-color: #059669; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

    <!-- TABLEAU -->
    <TableView fx:id="tableEquipes" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
        <columns>
            <TableColumn fx:id="colNom" text="Équipe" prefWidth="200"/>
            <TableColumn fx:id="colPays" text="Pays" prefWidth="150"/>
            <TableColumn fx:id="colEntraineur" text="Entraîneur" prefWidth="150"/>
            <TableColumn fx:id="colNombreJoueurs" text="Joueurs" prefWidth="80"/>
            <TableColumn fx:id="colMatchsJoues" text="MJ" prefWidth="60"/>
            <TableColumn fx:id="colVictoires" text="V" prefWidth="50"/>
            <TableColumn fx:id="colNuls" text="N" prefWidth="50"/>
            <TableColumn fx:id="colDefaites" text="D" prefWidth="50"/>
            <TableColumn fx:id="colButsMarques" text="BP" prefWidth="60"/>
            <TableColumn fx:id="colButsEncaisses" text="BC" prefWidth="60"/>
            <TableColumn fx:id="colPoints" text="Pts" prefWidth="60"/>
        </columns>
    </TableView>

    <!-- LABELS -->
    <HBox spacing="15">
        <Label fx:id="labelNombreEquipes" text="0 équipe(s)" style="-fx-text-fill: #64748b; -fx-font-size: 14px;"/>
        <Label fx:id="labelSucces" text="" style="-fx-text-fill: #059669; -fx-font-size: 14px; -fx-font-weight: bold;" visible="false"/>
        <Label fx:id="labelErreur" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 14px; -fx-font-weight: bold;" visible="false"/>
    </HBox>

</VBox>
