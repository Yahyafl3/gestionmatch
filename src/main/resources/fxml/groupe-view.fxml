<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.gestionmatch.controller.GroupeViewController"
      spacing="25" style="-fx-padding: 30;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="⚽ COUPE DU MONDE 2030 - PHASE DE GROUPES" 
               style="-fx-text-fill: #1e293b; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Créer Groupe" onAction="#creerGroupe" 
                style="-fx-background-color: #2d5a3d; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 24; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600;"/>
    </HBox>

    <!-- Grille des Groupes -->
    <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <GridPane fx:id="groupesGrid" hgap="20" vgap="20" style="-fx-padding: 10;">
        </GridPane>
    </ScrollPane>

</VBox>
