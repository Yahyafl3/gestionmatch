<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../styles/tables.css">

    <!-- IMAGE DE FOND -->
    <ImageView preserveRatio="false" fitWidth="2000" fitHeight="1200" opacity="0.35" smooth="true">
        <image>
            <Image url="@../images/Image-18-10-2025-a-09.51-1.jpeg" backgroundLoading="true"/>
        </image>
    </ImageView>
    
    <!-- OVERLAY -->
    <Pane style="-fx-background-color: rgba(10, 14, 39, 0.65);"/>

    <BorderPane fx:controller="com.example.gestionmatch.controller.GroupeViewController"
                style="-fx-background-color: transparent;">

        <top>
            <VBox spacing="15" style="-fx-background-color: rgba(26, 31, 58, 0.95); -fx-padding: 20;">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="📋 PHASE DE GROUPES - COUPE DU MONDE 2030" 
                           style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="➕ Créer Groupe" onAction="#creerGroupe" 
                            style="-fx-background-color: #006233; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 24; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600;"/>
                </HBox>
            </VBox>
        </top>

        <center>
            <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                <GridPane fx:id="groupesGrid" hgap="20" vgap="20" style="-fx-padding: 30;">
                </GridPane>
            </ScrollPane>
        </center>

        <bottom>
            <HBox alignment="CENTER" style="-fx-background-color: rgba(26, 31, 58, 0.95); -fx-padding: 15;">
                <Label text="© 2030 FIFA World Cup - Phase de Groupes" style="-fx-text-fill: #666666; -fx-font-size: 11px;"/>
            </HBox>
        </bottom>

    </BorderPane>
</StackPane>
