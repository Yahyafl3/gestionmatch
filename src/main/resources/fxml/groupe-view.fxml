<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           style="-fx-background-color: #0a0e27;">

    <!-- IMAGE DE FOND -->
    <ImageView preserveRatio="false" fitWidth="1920" fitHeight="1080" opacity="0.4">
        <image>
            <Image url="@../images/wp7860573.jpg"/>
        </image>
    </ImageView>
    
    <!-- OVERLAY -->
    <Pane style="-fx-background-color: rgba(10, 14, 39, 0.6);"/>

    <BorderPane fx:controller="com.example.gestionmatch.controller.GroupeController"
                style="-fx-background-color: transparent;">

        <top>
            <VBox spacing="15" style="-fx-background-color: rgba(26, 31, 58, 0.95); -fx-padding: 20;">
                <Label text="🏆 GESTION DES GROUPES" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Groupe:" style="-fx-text-fill: #cccccc;"/>
                    <ComboBox fx:id="comboGroupes" prefWidth="150" onAction="#afficherGroupe"
                              style="-fx-background-color: #0f1429;"/>
                    <Button text="🔄 Actualiser" onAction="#actualiser"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 6;"/>
                    <Button text="➕ Créer tous les groupes" onAction="#creerTousGroupes"
                            style="-fx-background-color: #006233; -fx-text-fill: white; -fx-background-radius: 6;"/>
                </HBox>

                <Label fx:id="labelInfoGroupe" style="-fx-text-fill: #FFD700;"/>
            </VBox>
        </top>

        <center>
            <HBox spacing="20" style="-fx-padding: 20;">
                <!-- ÉQUIPES DU GROUPE -->
                <VBox spacing="15" style="-fx-background-color: rgba(26, 31, 58, 0.95); -fx-padding: 25; -fx-background-radius: 12; -fx-min-width: 300;">
                    <Label text="📋 Équipes du groupe" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                    <ListView fx:id="listeEquipesGroupe" VBox.vgrow="ALWAYS" style="-fx-background-color: #0f1429;"/>

                    <VBox spacing="10" style="-fx-background-color: #0f1429; -fx-padding: 15; -fx-background-radius: 8;">
                        <Label text="Assigner une équipe" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="comboEquipesDisponibles" prefWidth="250" style="-fx-background-color: #1a1f3a;"/>
                        <ComboBox fx:id="comboGroupeDestination" prefWidth="250" style="-fx-background-color: #1a1f3a;"/>
                        <HBox spacing="10">
                            <Button text="Assigner" onAction="#assignerEquipe"
                                    style="-fx-background-color: #006233; -fx-text-fill: white; -fx-background-radius: 6;"/>
                            <Button text="Retirer" onAction="#retirerEquipe"
                                    style="-fx-background-color: #C1272D; -fx-text-fill: white; -fx-background-radius: 6;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- CLASSEMENT -->
                <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: rgba(26, 31, 58, 0.95); -fx-padding: 25; -fx-background-radius: 12;">
                    <Label text="📊 CLASSEMENT" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                    <TableView fx:id="tableClassement" VBox.vgrow="ALWAYS" style="-fx-background-color: #0f1429;">
                        <columns>
                            <TableColumn fx:id="colNom" text="Équipe" prefWidth="150"/>
                            <TableColumn fx:id="colMatchs" text="J" prefWidth="40"/>
                            <TableColumn fx:id="colVictoires" text="V" prefWidth="40"/>
                            <TableColumn fx:id="colNuls" text="N" prefWidth="40"/>
                            <TableColumn fx:id="colDefaites" text="D" prefWidth="40"/>
                            <TableColumn fx:id="colBP" text="BP" prefWidth="50"/>
                            <TableColumn fx:id="colBC" text="BC" prefWidth="50"/>
                            <TableColumn fx:id="colDiff" text="Diff" prefWidth="60"/>
                            <TableColumn fx:id="colPoints" text="Pts" prefWidth="60"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </center>

        <bottom>
            <HBox alignment="CENTER" style="-fx-background-color: rgba(26, 31, 58, 0.95); -fx-padding: 15;">
                <Label text="© 2030 FIFA World Cup - Gestion des Groupes" style="-fx-text-fill: #666666; -fx-font-size: 11px;"/>
            </HBox>
        </bottom>

    </BorderPane>
</StackPane>
