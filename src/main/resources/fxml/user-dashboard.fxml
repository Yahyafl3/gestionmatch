<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.example.gestionmatch.controller.UserDashboardController"
            stylesheets="@../styles/dashboard.css, @../styles/enhanced-dashboard.css">

    <!-- SIDEBAR GAUCHE ROUGE -->
    <left>
        <VBox style="-fx-background-color: #C1272D; -fx-pref-width: 220; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 5, 0);" spacing="0">
            
            <!-- Logo -->
            <VBox alignment="CENTER" style="-fx-padding: 25 15; -fx-background-color: transparent;" spacing="8">
                <ImageView fitWidth="180" fitHeight="80" preserveRatio="true">
                    <image>
                        <Image url="@../images/4.png" backgroundLoading="true" />
                    </image>
                </ImageView>
                <Label text="Dashboard Utilisateur" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 12px;"/>
            </VBox>

            <!-- Menu -->
            <VBox spacing="12" style="-fx-padding: 20 15;" alignment="TOP_LEFT">
                <Label text="MENU" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0 10 5 10;"/>
                
                <Button fx:id="btnAccueil" text="📊  Accueil" onAction="#afficherAccueil" 
                        style="-fx-background-color: #000000; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 190; -fx-pref-height: 45; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 10, 0, 0, 4);"/>
                
                <Button fx:id="btnJoueurs" text="👤  Joueurs" onAction="#afficherJoueurs" 
                        style="-fx-background-color: #000000; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 190; -fx-pref-height: 45; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 10, 0, 0, 4);"/>
                
                <Button fx:id="btnEquipes" text="🏆  Équipes" onAction="#afficherEquipes" 
                        style="-fx-background-color: #000000; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 190; -fx-pref-height: 45; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 10, 0, 0, 4);"/>
                
                <Button fx:id="btnStades" text="🏟️  Stades" onAction="#afficherStades" 
                        style="-fx-background-color: #000000; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 190; -fx-pref-height: 45; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 10, 0, 0, 4);"/>
                
                <Button fx:id="btnGroupes" text="📋  Groupes" onAction="#afficherGroupes" 
                        style="-fx-background-color: #000000; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 190; -fx-pref-height: 45; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 10, 0, 0, 4);"/>
                
                <Button fx:id="btnMatchs" text="⚽  Matchs" onAction="#afficherMatchs" 
                        style="-fx-background-color: #000000; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 190; -fx-pref-height: 45; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 10, 0, 0, 4);"/>
                
                <Button fx:id="btnFavoris" text="⭐  Favoris" onAction="#afficherFavoris" 
                        style="-fx-background-color: #000000; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 190; -fx-pref-height: 45; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 10, 0, 0, 4);"/>
                
                <Button fx:id="btnProfil" text="👤  Profil" onAction="#afficherProfil" 
                        style="-fx-background-color: #000000; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 190; -fx-pref-height: 45; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 10, 0, 0, 4);"/>
                
                <Label text="ANALYSES" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 20 10 5 10;"/>
                
                <Button fx:id="btnCalendrier" text="📅  Calendrier" onAction="#afficherCalendrier" 
                        style="-fx-background-color: #000000; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 190; -fx-pref-height: 45; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 10, 0, 0, 4);"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Logout -->
            <VBox style="-fx-padding: 20 15;" alignment="CENTER">
                <Button text="🚪  Déconnexion" onAction="#deconnecter" 
                        style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 190; -fx-pref-height: 45; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 10, 0, 0, 4); -fx-font-weight: 600;"/>
            </VBox>
        </VBox>
    </left>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <VBox>
            <!-- Top Bar -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: rgb(255,255,255); -fx-padding: 20 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                <VBox spacing="2">
                    <Label fx:id="pageTitle" text="Accueil" style="-fx-text-fill: #1e293b; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                    <Label text="Vue d'ensemble de la Coupe du Monde 2030" style="-fx-text-fill: #64748b; -fx-font-size: 14px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                
                <!-- Notifications -->
                <Button fx:id="btnNotifications" text="🔔" onAction="#afficherNotifications" 
                        style="-fx-background-color: white; -fx-background-radius: 12; -fx-pref-width: 48; -fx-pref-height: 48; -fx-font-size: 20px; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-width: 2; -fx-border-radius: 12;">
                    <graphic>
                        <StackPane>
                            <Label text="🔔" style="-fx-font-size: 20px;"/>
                            <Label fx:id="notificationBadge" text="2" styleClass="notification-badge" 
                                   style="-fx-translate-x: 12; -fx-translate-y: -12; -fx-min-width: 20; -fx-min-height: 20; -fx-alignment: center;"/>
                        </StackPane>
                    </graphic>
                </Button>
                
                <HBox spacing="15" alignment="CENTER">
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label fx:id="dateLabel" text="5 Janvier 2026" style="-fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                        <Label fx:id="timeLabel" text="19:30" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- Zone de contenu scrollable -->
            <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;">
                <StackPane fx:id="contentPane" style="-fx-padding: 30; -fx-background-color: transparent;">
                    
                    <!-- VUE ACCUEIL ULTRA MODERNE -->
                    <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #f8fafc; -fx-background: #f8fafc;">
                        <VBox fx:id="accueilView" spacing="40" alignment="TOP_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 0 0 40 0;">
                        
                        <!-- Hero Section avec dégradé -->
                        <VBox spacing="12" style="-fx-background-color: linear-gradient(to right, #C1272D, #8B1C1C); -fx-background-radius: 20; -fx-padding: 40 30; -fx-effect: dropshadow(gaussian, rgba(193, 39, 45, 0.3), 20, 0, 0, 10);">
                            <Label text="🏆 Coupe du Monde 2030" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);"/>
                            <Label text="Maroc • Portugal • Espagne" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 18px; -fx-font-weight: 600;"/>
                            <Label text="Suivez tous les matchs, équipes et statistiques en temps réel" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 15px;"/>
                        </VBox>
                        
                        <!-- Cartes Statistiques Modernes -->
                        <HBox spacing="25" alignment="CENTER">
                            <!-- Carte Joueurs -->
                            <VBox style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -fx-background-radius: 20; -fx-padding: 30; -fx-pref-width: 280; -fx-pref-height: 160; -fx-effect: dropshadow(gaussian, rgba(102, 126, 234, 0.4), 20, 0, 0, 10);" spacing="20" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <VBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.2); -fx-pref-width: 70; -fx-pref-height: 70; -fx-background-radius: 15;">
                                        <Label text="👤" style="-fx-font-size: 38px;"/>
                                    </VBox>
                                    <VBox spacing="5">
                                        <Label text="JOUEURS" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 12px; -fx-font-weight: 700; -fx-letter-spacing: 1px;"/>
                                        <Label fx:id="statJoueurs" text="0" style="-fx-text-fill: white; -fx-font-size: 38px; -fx-font-weight: bold;"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                            
                            <!-- Carte Équipes -->
                            <VBox style="-fx-background-color: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); -fx-background-radius: 20; -fx-padding: 30; -fx-pref-width: 280; -fx-pref-height: 160; -fx-effect: dropshadow(gaussian, rgba(240, 147, 251, 0.4), 20, 0, 0, 10);" spacing="20" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <VBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.2); -fx-pref-width: 70; -fx-pref-height: 70; -fx-background-radius: 15;">
                                        <Label text="🏆" style="-fx-font-size: 38px;"/>
                                    </VBox>
                                    <VBox spacing="5">
                                        <Label text="ÉQUIPES" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 12px; -fx-font-weight: 700; -fx-letter-spacing: 1px;"/>
                                        <Label fx:id="statEquipes" text="0" style="-fx-text-fill: white; -fx-font-size: 38px; -fx-font-weight: bold;"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                            
                            <!-- Carte Matchs -->
                            <VBox style="-fx-background-color: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); -fx-background-radius: 20; -fx-padding: 30; -fx-pref-width: 280; -fx-pref-height: 160; -fx-effect: dropshadow(gaussian, rgba(79, 172, 254, 0.4), 20, 0, 0, 10);" spacing="20" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <VBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.2); -fx-pref-width: 70; -fx-pref-height: 70; -fx-background-radius: 15;">
                                        <Label text="⚽" style="-fx-font-size: 38px;"/>
                                    </VBox>
                                    <VBox spacing="5">
                                        <Label text="MATCHS" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 12px; -fx-font-weight: 700; -fx-letter-spacing: 1px;"/>
                                        <Label fx:id="statMatchs" text="0" style="-fx-text-fill: white; -fx-font-size: 38px; -fx-font-weight: bold;"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                            
                            <!-- Carte Stades -->
                            <VBox style="-fx-background-color: linear-gradient(135deg, #fa709a 0%, #fee140 100%); -fx-background-radius: 20; -fx-padding: 30; -fx-pref-width: 280; -fx-pref-height: 160; -fx-effect: dropshadow(gaussian, rgba(250, 112, 154, 0.4), 20, 0, 0, 10);" spacing="20" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <VBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.2); -fx-pref-width: 70; -fx-pref-height: 70; -fx-background-radius: 15;">
                                        <Label text="🏟️" style="-fx-font-size: 38px;"/>
                                    </VBox>
                                    <VBox spacing="5">
                                        <Label text="STADES" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 12px; -fx-font-weight: 700; -fx-letter-spacing: 1px;"/>
                                        <Label fx:id="statStades" text="0" style="-fx-text-fill: white; -fx-font-size: 38px; -fx-font-weight: bold;"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </HBox>
                        
                        <!-- Section Prochains Matchs et Favoris -->
                        <HBox spacing="30" VBox.vgrow="ALWAYS">
                            
                            <!-- Prochains Matchs avec design moderne -->
                            <VBox spacing="25" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 8);" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <VBox alignment="CENTER" style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -fx-pref-width: 50; -fx-pref-height: 50; -fx-background-radius: 12;">
                                        <Label text="⚽" style="-fx-font-size: 26px;"/>
                                    </VBox>
                                    <VBox spacing="2">
                                        <Label text="Prochains Matchs" style="-fx-text-fill: #1e293b; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                                        <Label text="Les matchs à venir" style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Voir tout →" onAction="#afficherMatchs" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 10 20; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(102, 126, 234, 0.3), 10, 0, 0, 3);"/>
                                </HBox>
                                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" prefHeight="320">
                                    <VBox fx:id="prochainsMatchsBox" spacing="15" style="-fx-background-color: transparent;"/>
                                </ScrollPane>
                            </VBox>
                            
                            <!-- Mes Favoris avec design moderne -->
                            <VBox spacing="25" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 8);" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <VBox alignment="CENTER" style="-fx-background-color: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); -fx-pref-width: 50; -fx-pref-height: 50; -fx-background-radius: 12;">
                                        <Label text="⭐" style="-fx-font-size: 26px;"/>
                                    </VBox>
                                    <VBox spacing="2">
                                        <Label text="Mes Favoris" style="-fx-text-fill: #1e293b; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                                        <Label text="Vos équipes préférées" style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Voir tout →" onAction="#afficherFavoris" style="-fx-background-color: linear-gradient(to right, #f093fb, #f5576c); -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 10 20; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(240, 147, 251, 0.3), 10, 0, 0, 3);"/>
                                </HBox>
                                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" prefHeight="320">
                                    <VBox fx:id="favorisAccueilBox" spacing="15" style="-fx-background-color: transparent;"/>
                                </ScrollPane>
                            </VBox>
                            
                        </HBox>
                        
                        <!-- Section Groupes avec design moderne -->
                        <VBox spacing="25" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 8);">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <VBox alignment="CENTER" style="-fx-background-color: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); -fx-pref-width: 50; -fx-pref-height: 50; -fx-background-radius: 12;">
                                    <Label text="📋" style="-fx-font-size: 26px;"/>
                                </VBox>
                                <VBox spacing="2">
                                    <Label text="Groupes de la Coupe du Monde" style="-fx-text-fill: #1e293b; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                                    <Label text="Phase de groupes" style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Voir tout →" onAction="#afficherGroupes" style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe); -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 10 20; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(79, 172, 254, 0.3), 10, 0, 0, 3);"/>
                            </HBox>
                            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                                <HBox fx:id="groupesAccueilBox" spacing="20" style="-fx-background-color: transparent; -fx-padding: 10;"/>
                            </ScrollPane>
                        </VBox>
                        
                    </VBox>
                    </ScrollPane>

                    <!-- VUE JOUEURS AVEC RECHERCHE -->
                    <VBox fx:id="joueursView" visible="false" spacing="25">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <TextField fx:id="searchJoueur" promptText="🔍 Rechercher un joueur..." style="-fx-pref-width: 300; -fx-pref-height: 40; -fx-font-size: 14px; -fx-background-radius: 8;"/>
                            <ComboBox fx:id="filterEquipeJoueur" promptText="Filtrer par équipe" style="-fx-pref-width: 200; -fx-cursor: hand;"/>
                            <ComboBox fx:id="filterPosteJoueur" promptText="Filtrer par poste" style="-fx-pref-width: 200; -fx-cursor: hand;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="🔄 Actualiser" onAction="#actualiserJoueurs" 
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: 600;"/>
                        </HBox>
                        <TableView fx:id="tableJoueurs" VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <!-- VUE ÉQUIPES AVEC RECHERCHE -->
                    <VBox fx:id="equipesView" visible="false" spacing="25">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <TextField fx:id="searchEquipe" promptText="🔍 Rechercher une équipe..." style="-fx-pref-width: 300; -fx-pref-height: 40; -fx-font-size: 14px;"/>
                            <ComboBox fx:id="filterGroupeEquipe" promptText="Filtrer par groupe" style="-fx-pref-width: 200; -fx-cursor: hand;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="⭐ Ajouter aux Favoris" onAction="#ajouterAuxFavoris" 
                                    style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: 600;"/>
                            <Button text="🔄 Actualiser" onAction="#actualiserEquipes" 
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: 600;"/>
                        </HBox>
                        <TableView fx:id="tableEquipes" VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <!-- VUE STADES AVEC FILTRES -->
                    <VBox fx:id="stadesView" visible="false" spacing="25">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <TextField fx:id="searchStade" promptText="🔍 Rechercher un stade..." style="-fx-pref-width: 300; -fx-pref-height: 40; -fx-font-size: 14px;"/>
                            <ComboBox fx:id="filterPaysStade" promptText="Filtrer par pays" style="-fx-pref-width: 200; -fx-cursor: hand;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="🔄 Actualiser" onAction="#actualiserStades" 
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: 600;"/>
                        </HBox>
                        <TableView fx:id="tableStades" VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <!-- VUE GROUPES (MÊME AFFICHAGE QUE ADMIN) -->
                    <VBox fx:id="groupesView" visible="false" spacing="28">
                        <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 4);">
                            <Label text="📋 Groupes de la Coupe du Monde" style="-fx-text-fill: #0f172a; -fx-font-size: 26px; -fx-font-weight: 700; -fx-letter-spacing: -0.5px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="🔄 Actualiser" onAction="#actualiserGroupes" 
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 14 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.25), 10, 0, 0, 3);"/>
                        </HBox>
                        
                        <!-- Grille des groupes (identique à Admin) -->
                        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                            <GridPane fx:id="groupesGrid" hgap="22" vgap="22" style="-fx-padding: 12; -fx-background-color: transparent;"/>
                        </ScrollPane>
                    </VBox>

                    <!-- VUE MATCHS AVEC FILTRES -->
                    <VBox fx:id="matchsView" visible="false" spacing="25">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <ComboBox fx:id="filterEquipeMatch" promptText="Filtrer par équipe" style="-fx-pref-width: 200; -fx-cursor: hand;"/>
                            <ComboBox fx:id="filterGroupeMatch" promptText="Filtrer par groupe" style="-fx-pref-width: 200; -fx-cursor: hand;"/>
                            <ComboBox fx:id="filterStadeMatch" promptText="Filtrer par stade" style="-fx-pref-width: 200; -fx-cursor: hand;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="🔄 Actualiser" onAction="#actualiserMatchs" 
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: 600;"/>
                        </HBox>
                        <TableView fx:id="tableMatchs" VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <!-- VUE FAVORIS -->
                    <VBox fx:id="favorisView" visible="false" spacing="25">
                        <Label text="⭐ Mes Équipes Favorites" style="-fx-text-fill: #1e293b; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                        <TableView fx:id="tableFavoris" VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <!-- VUE PROFIL -->
                    <VBox fx:id="profilView" visible="false" spacing="30" alignment="TOP_CENTER" style="-fx-padding: 20;">
                        <!-- Carte Profil -->
                        <VBox spacing="25" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 12; -fx-max-width: 700; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);">
                            <!-- En-tête -->
                            <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #C1272D; -fx-padding: 20; -fx-background-radius: 10;">
                                <Label text="👤" style="-fx-font-size: 40px;"/>
                                <Label text="Mon Profil" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                            </HBox>
                            
                            <!-- Informations -->
                            <VBox spacing="20" style="-fx-padding: 10;">
                                <!-- Email -->
                                <VBox spacing="8">
                                    <Label text="📧 ADRESSE EMAIL" style="-fx-text-fill: #000000; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                    <Label fx:id="profilEmail" text="user@example.com" style="-fx-text-fill: #333; -fx-font-size: 16px; -fx-padding: 10; -fx-background-color: #f5f5f5; -fx-background-radius: 8;"/>
                                </VBox>
                                
                                <!-- Nom -->
                                <VBox spacing="8">
                                    <Label text="👤 NOM COMPLET" style="-fx-text-fill: #000000; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                    <Label fx:id="profilNom" text="Utilisateur" style="-fx-text-fill: #333; -fx-font-size: 16px; -fx-padding: 10; -fx-background-color: #f5f5f5; -fx-background-radius: 8;"/>
                                </VBox>
                            </VBox>
                            
                            <!-- Séparateur -->
                            <Separator style="-fx-background-color: #e0e0e0;"/>
                            
                            <!-- Actions -->
                            <VBox spacing="15" alignment="CENTER">
                                <Label text="SÉCURITÉ DU COMPTE" style="-fx-text-fill: #000000; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                                <Button text="🔒 Changer mon mot de passe" onAction="#changerMotDePasse" 
                                        style="-fx-background-color: #C1272D; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-pref-width: 350; -fx-pref-height: 50; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(193, 39, 45, 0.3), 10, 0, 0, 3);"/>
                            </VBox>
                        </VBox>
                    </VBox>

                </StackPane>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
