<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.gestionmatch.controller.InscriptionController">

    <HBox prefWidth="1600" prefHeight="900">

        <!-- GAUCHE -->
        <StackPane prefWidth="960">
            <ImageView fitWidth="960" fitHeight="900" preserveRatio="false">
                <image>
                    <Image url="@../images/pexels-pixabay-47730.jpg"/>
                </image>
            </ImageView>

            <Pane style="-fx-background-color: rgba(0,0,40,0.55);"/>

            <VBox alignment="TOP_LEFT" spacing="25" style="-fx-padding: 60;">
                <Label text="FIFA ID"
                       style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>

                <Label text="Rejoignez l'aventure."
                       style="-fx-text-fill: white;
                              -fx-font-size: 56px;
                              -fx-font-weight: bold;"/>

                <Label text="Créez votre compte pour vivre la Coupe du Monde 2030."
                       style="-fx-text-fill: white; -fx-font-size: 18px;"/>
            </VBox>
        </StackPane>

        <!-- DROITE -->
        <VBox prefWidth="640" alignment="CENTER_LEFT" spacing="18"
              style="-fx-background-color: white; -fx-padding: 70;">

            <Label text="Créer un compte"
                   style="-fx-font-size: 36; -fx-font-weight: bold;"/>

            <TextField promptText="Prénom"/>
            <TextField promptText="Nom"/>
            <TextField promptText="Email"/>
            <PasswordField promptText="Mot de passe"/>
            <PasswordField promptText="Confirmer le mot de passe"/>

            <Button text="S'INSCRIRE"
                    onAction="#sInscrire"
                    prefHeight="45"
                    prefWidth="260"
                    style="-fx-background-color: #006233;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 25;"/>

            <Button text="← Retour à l'accueil"
                    onAction="#retourAccueil"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #666;"/>
        </VBox>

    </HBox>
</StackPane>
