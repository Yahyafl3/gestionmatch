<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.gestionmatch.controller.InscriptionController"
           stylesheets="@../styles/style.css"
           styleClass="root-stack">

    <!-- Overlay semi-transparent -->
    <Region styleClass="overlay-region" />

    <!-- Formulaire centré - INSCRIPTION -->
    <VBox fx:id="signupCard" styleClass="login-card" alignment="CENTER" spacing="2" prefWidth="320" maxWidth="320" prefHeight="420" maxHeight="420">

        <VBox alignment="CENTER" spacing="0">
            <Label text="Inscription" styleClass="form-title" />
        </VBox>

        <VBox spacing="3" prefWidth="280">
            <VBox spacing="1">
                <Label text="Prénom" styleClass="label-bold" />
                <TextField fx:id="registerPrenom" promptText="Votre prénom" styleClass="form-field" />
            </VBox>

            <VBox spacing="1">
                <Label text="Nom" styleClass="label-bold" />
                <TextField fx:id="registerNom" promptText="Votre nom" styleClass="form-field" />
            </VBox>

            <VBox spacing="1">
                <Label text="Email" styleClass="label-bold" />
                <TextField fx:id="registerEmail" promptText="votre@email.com" styleClass="form-field" />
            </VBox>

            <VBox spacing="1">
                <Label text="Mot de passe" styleClass="label-bold" />
                <PasswordField fx:id="registerPassword" promptText="Min. 6 caractères" styleClass="form-field" />
            </VBox>

            <VBox spacing="1">
                <Label text="Confirmer" styleClass="label-bold" />
                <PasswordField fx:id="registerPasswordConfirm" promptText="Confirmez le mot de passe" styleClass="form-field" />
            </VBox>

            <Button fx:id="signupButton" text="S'inscrire" onAction="#sInscrire" styleClass="btn-primary" prefWidth="280" maxWidth="280" />

            <HBox alignment="CENTER" spacing="4">
                <Label text="Déjà un compte ?" styleClass="signup-text" />
                <Hyperlink text="Se connecter" onAction="#allerConnexion" styleClass="link-signup" />
            </HBox>

        </VBox>

    </VBox>

</StackPane>
