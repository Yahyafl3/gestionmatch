<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.gestionmatch.controller.MainController"
      spacing="15">

    <!-- Padding correct pour VBox -->
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Statut de connexion -->
    <HBox alignment="CENTER" spacing="10">
        <Label text="Statut : " style="-fx-font-weight: bold;"/>
        <Label fx:id="statusLabel" text="Non connecté"
               style="-fx-text-fill: orange;"/>
        <Button text="Tester Connexion" onAction="#testConnection"/>
    </HBox>

    <Separator/>

    <!-- Formulaire d'ajout -->
    <GridPane hgap="10" vgap="10">
        <Label text="Nom du match :" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nomField" GridPane.columnIndex="1" GridPane.rowIndex="0"
                   promptText="Ex: PSG vs OM"/>

        <Label text="Score :" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="scoreField" GridPane.columnIndex="1" GridPane.rowIndex="1"
                   promptText="Ex: 2-1"/>

        <Label text="Date :" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <!-- Boutons d'action -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="➕ Ajouter" onAction="#ajouterMatch"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="🔍 Rechercher" onAction="#rechercherMatch"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        <Button text="📋 Charger Tous" onAction="#chargerMatches"
                style="-fx-background-color: #FF9800; -fx-text-fill: white;"/>
        <Button text="🗑️ Supprimer Tout" onAction="#supprimerTout"
                style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
    </HBox>

    <Separator/>

    <!-- Zone d'affichage des résultats -->
    <Label text="Résultats :" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
    <TextArea fx:id="resultArea" prefHeight="300" editable="false"
              style="-fx-font-family: monospace;"/>

</VBox>